[gd_scene load_steps=4 format=3 uid="uid://click_marker_01"]

[sub_resource type="GDScript" id="GDScript_marker"]
script/source = "extends Node3D

func _ready() -> void:
	var mesh = $Ring
	scale = Vector3(0.2, 0.2, 0.2)
	var tween = create_tween().set_parallel(true)
	tween.tween_property(self, \"scale\", Vector3(1.2, 1.2, 1.2), 0.35)
	if mesh and mesh.material_override:
		tween.tween_property(mesh.material_override, \"albedo_color:a\", 0.0, 0.35)
	await tween.finished
	queue_free()
"

[sub_resource type="TorusMesh" id="TorusMesh_ring"]
inner_radius = 0.45
outer_radius = 0.55
rings = 24
ring_segments = 16

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_ring"]
transparency = 1
albedo_color = Color(0.2, 0.9, 0.4, 0.9)
emission_enabled = true
emission = Color(0.2, 0.9, 0.4, 1)
emission_energy_multiplier = 2.0

[node name="ClickMarker" type="Node3D"]
script = SubResource("GDScript_marker")

[node name="Ring" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.02, 0)
mesh = SubResource("TorusMesh_ring")
material_override = SubResource("StandardMaterial3D_ring")
